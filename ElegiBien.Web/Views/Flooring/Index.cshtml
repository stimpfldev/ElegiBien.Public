@model ElegiBien.Web.Models.Flooring.FlooringQuickViewModel
@using ElegiBien.Domain.Enums

@{
    ViewData["Title"] = "Cuántos cerámicos o pisos necesito";
    ViewData["Description"] = "Calculá cuántos cerámicos o pisos necesitás según la superficie, el tipo de colocación y el material adicional recomendado.";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1>Cuántos cerámicos o pisos necesitás</h1>

            <p class="lead">
                Calculá la superficie y el material adicional recomendado para cortes, roturas y futuras reposiciones.
            </p>

            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3" data-validation-summary>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.LengthMeters"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <input asp-for="Input.LengthMeters"
                                   class="form-control"
                                   step="0.01" />
                            <span class="input-group-text">m</span>
                        </div>

                        <span asp-validation-for="Input.LengthMeters"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.WidthMeters"
                               class="form-label">
                        </label>

                        <div class="input-group">
                            <input asp-for="Input.WidthMeters"
                                   class="form-control"
                                   step="0.01" />
                            <span class="input-group-text">m</span>
                        </div>

                        <span asp-validation-for="Input.WidthMeters"
                              class="text-danger">
                        </span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.InstallationPattern"
                               class="form-label">
                        </label>

                        <select asp-for="Input.InstallationPattern"
                                class="form-select"
                                id="installationPattern" data-flooring-pattern>
                            <option value="@FlooringInstallationPattern.Straight">
                                Recta
                            </option>
                            <option value="@FlooringInstallationPattern.Staggered">
                                Trabada
                            </option>
                            <option value="@FlooringInstallationPattern.Diagonal">
                                Diagonal
                            </option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <span class="form-label d-block">Material adicional calculado</span>
                        <div class="recommendation-panel" aria-live="polite">
                            <strong id="wasteRecommendationValue" data-flooring-waste-value>10 %</strong>
                            <span id="wasteExplanation" data-flooring-waste-explanation>para cortes, roturas y futuras reposiciones.</span>
                        </div>
                        <input asp-for="Input.WastePercentage" type="hidden" id="wastePercentage" data-flooring-waste />
                    </div>
                </div>

                <div class="form-check mb-2">
                    <input asp-for="AllowAnonymousAnalytics"
                           class="form-check-input" />
                    <label asp-for="AllowAnonymousAnalytics"
                           class="form-check-label">
                        Permitir analítica anónima para mejorar ElegíBien.
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="AllowRadarData"
                           class="form-check-input" />
                    <label asp-for="AllowRadarData"
                           class="form-check-label">
                        Permitir el uso anónimo de este resultado en estadísticas agregadas.
                    </label>
                </div>

                <div class="mobile-submit-bar">


                    <button class="btn btn-primary"
                        type="submit">
                    Calcular superficie
                </button>


                </div>
            </form>

            @if (Model.Result is not null)
            {
                <div class="card mt-4 result-focus-target" data-auto-scroll-target tabindex="-1">
                    <div class="card-body">
                        <h2 class="h3">Resultado orientativo</h2>

                        <dl class="row mb-0">
                            <dt class="col-sm-7">Superficie del piso</dt>
                            <dd class="col-sm-5">
                                @Model.Result.TotalAreaSquareMeters.ToString("N2") m²
                            </dd>

                            <dt class="col-sm-7">Material adicional aplicado</dt>
                            <dd class="col-sm-5">
                                @Model.Result.WastePercentage.ToString("N1") %
                            </dd>

                            <dt class="col-sm-7">Superficie adicional</dt>
                            <dd class="col-sm-5">
                                @Model.Result.WasteAreaSquareMeters.ToString("N2") m²
                            </dd>

                            <dt class="col-sm-7">Superficie total necesaria</dt>
                            <dd class="col-sm-5 fs-5">
                                <strong>
                                    @Model.Result.RequiredAreaSquareMeters.ToString("N2") m²
                                </strong>
                            </dd>
                        </dl>

                        <p class="mt-3 mb-2">
                            @Model.Result.Explanation
                        </p>

                        @if (Model.Result.RequiresProfessionalReview)
                        {
                            <div class="alert alert-warning mb-3">
                                Conviene revisar medidas, cortes y disposición antes de comprar.
                            </div>
                        }

                        <a asp-action="Compare"
                           asp-route-id="@Model.Result.AnalysisId"
                           class="btn btn-outline-primary">
                            Comparar dos productos
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
