@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "EligeBien";
    var robots = ViewData["Robots"] as string;
    var description = ViewData["Description"]?.ToString()
        ?? "EligeBien ayuda a calcular qué producto necesitás y comparar alternativas mediante criterios claros y explicables.";
    var isIndexable = string.IsNullOrWhiteSpace(robots)
        || !robots.Contains("noindex", StringComparison.OrdinalIgnoreCase);
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
    var cspNonce = Context.Items[ElegiBien.Web.Configuration.ApplicationBuilderExtensions.CspNonceItemKey]?.ToString();

    var searchConsoleVerificationToken = Configuration["GoogleSearchConsole:VerificationToken"]?.Trim();

    var googleAnalyticsEnabled = string.Equals(
        Configuration["GoogleAnalytics:Enabled"],
        "true",
        StringComparison.OrdinalIgnoreCase);
    var googleAnalyticsMeasurementId = Configuration["GoogleAnalytics:MeasurementId"]?.Trim();
    var loadGoogleAnalytics = googleAnalyticsEnabled
        && !string.IsNullOrWhiteSpace(googleAnalyticsMeasurementId)
        && googleAnalyticsMeasurementId.StartsWith("G-", StringComparison.OrdinalIgnoreCase)
        && isIndexable;

    var googleAdSenseEnabled = string.Equals(
        Configuration["GoogleAdSense:Enabled"],
        "true",
        StringComparison.OrdinalIgnoreCase);
    var googleAdSensePublisherId = Configuration["GoogleAdSense:PublisherId"]?.Trim();
    var loadGoogleAdSense = googleAdSenseEnabled
        && !string.IsNullOrWhiteSpace(googleAdSensePublisherId)
        && googleAdSensePublisherId.StartsWith("ca-pub-", StringComparison.OrdinalIgnoreCase)
        && isIndexable;
}
<!DOCTYPE html>
<html lang="es-AR">
<head>
    @if (!string.IsNullOrWhiteSpace(robots))
    {
        <meta name="robots" content="@robots" />
    }

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@description" />
    @if (isIndexable && Context.Request.Host.HasValue)
    {
        <link rel="canonical" href="@canonicalUrl" />
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EligeBien" />
    <meta property="og:title" content="@pageTitle - EligeBien" />
    <meta property="og:description" content="@description" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle - EligeBien" />
    <meta name="twitter:description" content="@description" />
    <meta name="theme-color" content="#123c69" />
    <meta name="application-name" content="EligeBien" />

    @if (!string.IsNullOrWhiteSpace(searchConsoleVerificationToken))
    {
        <meta name="google-site-verification" content="@searchConsoleVerificationToken" />
    }

    @if (loadGoogleAnalytics)
    {
        <meta name="google-analytics-measurement-id" content="@googleAnalyticsMeasurementId" />
    }

    @if (loadGoogleAdSense)
    {
        <script nonce="@cspNonce"
                async
                src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@googleAdSensePublisherId"
                crossorigin="anonymous"></script>
    }

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <title>@pageTitle - EligeBien</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElegiBien.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/desktop-compact.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand brand-lockup"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-label="EligeBien, inicio">
                    <img src="~/images/elegibien-logo.svg" asp-append-version="true"
                         alt=""
                         width="176"
                         height="44" />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="AirConditioning"
                               asp-action="Index">
                                Aire acondicionado
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Paint"
                               asp-action="Index">
                                Pintura
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Flooring"
                               asp-action="Index">
                                Cerámicos y pisos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Heating"
                               asp-action="Index">
                                Calefacción
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Contact"
                               asp-action="Index">
                                Contacto
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link nav-link-methodology"
                               asp-controller="Legal"
                               asp-action="Methodology">
                                Cómo decidimos
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div>
                    <img src="~/images/elegibien-logo-monochrome.svg" asp-append-version="true"
                         alt="EligeBien"
                         width="142"
                         height="36" />
                    <p class="footer-description">
                        Decisiones de compra más claras, con cálculos y criterios explicables.
                    </p>
                </div>

                <nav class="footer-links" aria-label="Enlaces legales">
                    <a asp-controller="Legal" asp-action="Privacy">Privacidad</a>
                    <a asp-controller="Legal" asp-action="Terms">Términos</a>
                    <a asp-controller="Legal" asp-action="Methodology">Metodología</a>
                    <a asp-controller="Contact" asp-action="Index">Contacto</a>
                </nav>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 EligeBien</span>
                <span>Hecho en Argentina</span>
            </div>
        </div>
    </footer>

    <script nonce="@cspNonce" src="~/lib/jquery/dist/jquery.min.js"></script>
    <script nonce="@cspNonce" src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script nonce="@cspNonce" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
