@model ElegiBien.Application.DTOs.SharedPaintResultDto
@using ElegiBien.Domain.Enums

@{
    ViewData["Title"] = "Resultado compartido de pintura";
    ViewData["Robots"] = "noindex, nofollow";
}

@functions {
    private static string CoverageStatusText(
        PaintCoverageStatus value)
    {
        return value switch
        {
            PaintCoverageStatus.Adequate =>
                "Adecuada",

            PaintCoverageStatus.Excessive =>
                "Exceso de compra",

            PaintCoverageStatus.Insufficient =>
                "Insuficiente",

            _ => "Desconocida"
        };
    }

    private static string ConfidenceText(
        ConfidenceLevel value)
    {
        return value switch
        {
            ConfidenceLevel.Low => "Baja",
            ConfidenceLevel.Medium => "Media",
            ConfidenceLevel.High => "Alta",
            _ => "Desconocida"
        };
    }

    private static string FactorText(
        PaintScoreFactorType value)
    {
        return value switch
        {
            PaintScoreFactorType.CoverageAdequacy =>
                "Aprovechamiento",

            PaintScoreFactorType.TotalCost =>
                "Costo total",

            PaintScoreFactorType.Washability =>
                "Lavabilidad",

            PaintScoreFactorType.DryingTime =>
                "Secado",

            _ => "Factor"
        };
    }
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1>Resultado ElegíBien: Pintura</h1>

            <p>
                Superficie neta:
                <strong>
                    @Model.NetAreaSquareMeters.ToString("N2") m²
                </strong>
            </p>

            <p>
                Referencia inicial:
                <strong>
                    @Model.ReferenceLiters.ToString("N2") litros
                </strong>
                para @Model.CoatCount manos.
            </p>

            <div class="alert alert-primary">
                @Model.Recommendation
            </div>

            @foreach (var product in Model.Products)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h4">
                            @product.ProductName
                        </h2>

                        <p class="fs-4">
                            <strong>
                                @product.TotalScore/100
                            </strong>
                        </p>

                        <p>
                            @product.ContainersRequired envases ·
                            @product.LitersPurchased.ToString("N2") litros ·
                            $@product.TotalCost.ToString("N2")
                        </p>

                        <p>
                            Cobertura:
                            <strong>
                                @CoverageStatusText(product.CoverageStatus)
                            </strong>
                        </p>

                        <p>
                            Confianza:
                            <strong>
                                @ConfidenceText(product.ConfidenceLevel)
                            </strong>
                        </p>

                        <ul>
                            @foreach (var factor in product.Factors)
                            {
                                <li class="mb-2">
                                    <strong>
                                        @FactorText(factor.FactorType):
                                        @factor.Score.ToString("N1")
                                        /
                                        @factor.MaximumScore.ToString("N0")
                                    </strong>

                                    <br />

                                    @factor.Explanation
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="alert alert-info">
                Resultado orientativo. Revisá la ficha técnica y prepará correctamente la superficie.
            </div>

            <a asp-controller="Paint"
               asp-action="Index"
               class="btn btn-primary">
                Calcular otra superficie
            </a>
        </div>
    </div>
</div>
