@model ElegiBien.Application.DTOs.SharedAirConditioningResultDto
@using ElegiBien.Domain.Enums

@{
    ViewData["Title"] = "Resultado compartido";
    ViewData["Robots"] = "noindex, nofollow";
}

@functions {
    private static string CapacityStatusText(CapacityFitStatus value) =>
        value switch
        {
            CapacityFitStatus.Insufficient => "Insuficiente",
            CapacityFitStatus.Correct => "Correcta",
            CapacityFitStatus.AcceptableOversized => "Sobredimensionada aceptable",
            CapacityFitStatus.RelevantOversized => "Sobredimensionada relevante",
            _ => "Desconocida"
        };

    private static string ConfidenceText(ConfidenceLevel value) =>
        value switch
        {
            ConfidenceLevel.Low => "Baja",
            ConfidenceLevel.Medium => "Media",
            ConfidenceLevel.High => "Alta",
            _ => "Desconocida"
        };

    private static string FactorText(ScoreFactorType value) =>
        value switch
        {
            ScoreFactorType.CapacityAdequacy => "Adecuación de capacidad",
            ScoreFactorType.Efficiency => "Eficiencia",
            ScoreFactorType.RelativePrice => "Precio relativo",
            ScoreFactorType.Warranty => "Garantía",
            _ => "Factor"
        };
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1>Resultado ElegíBien: Aire acondicionado</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h4">Resultado del cálculo</h2>

                    <p class="lead mb-2">
                        Necesitás aproximadamente entre
                        <strong>@Model.RecommendedMinimumFrigories.ToString("N0")</strong>
                        y
                        <strong>@Model.RecommendedMaximumFrigories.ToString("N0") frigorías</strong>.
                    </p>

                    <p>
                        Capacidad ideal aproximada:
                        <strong>@Model.IdealFrigories.ToString("N0") frigorías</strong>
                    </p>

                    <p>
                        Superficie:
                        <strong>@Model.SurfaceSquareMeters.ToString("N1") m²</strong>
                    </p>

                    <p>
                        Volumen:
                        <strong>@Model.VolumeCubicMeters.ToString("N1") m³</strong>
                    </p>

                    <p class="mb-0">
                        Nivel de confianza:
                        <strong>@ConfidenceText(Model.ConfidenceLevel)</strong>
                    </p>
                </div>
            </div>

            @if (Model.RequiresProfessionalReview)
            {
                <div class="alert alert-warning">
                    Este ambiente presenta condiciones que requieren revisión profesional antes de comprar o instalar el equipo.
                </div>
            }

            @if (Model.Products.Count > 0)
            {
                <h2 class="h4 mt-4">Comparación de productos</h2>

                <div class="alert alert-primary">
                    @Model.Recommendation
                </div>

                @foreach (var product in Model.Products)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <h3 class="h5">@product.ProductName</h3>

                            <p class="fs-4">
                                <strong>@product.TotalScore/100</strong>
                            </p>

                            <p>
                                Estado de capacidad:
                                <strong>@CapacityStatusText(product.CapacityStatus)</strong>
                            </p>

                            <p>
                                Nivel de confianza:
                                <strong>@ConfidenceText(product.ConfidenceLevel)</strong>
                            </p>

                            <ul>
                                @foreach (var factor in product.Factors)
                                {
                                    <li class="mb-2">
                                        <strong>
                                            @FactorText(factor.FactorType):
                                            @factor.Score.ToString("N1") /
                                            @factor.MaximumScore.ToString("N0")
                                        </strong>
                                        <br />
                                        @factor.Explanation
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-secondary">
                    Este enlace comparte el resultado del cálculo. No se realizó una comparación de productos para este análisis.
                </div>
            }

            <div class="alert alert-info">
                Este resultado es orientativo y no reemplaza la evaluación de un técnico matriculado.
            </div>

            <a asp-controller="AirConditioning"
               asp-action="Index"
               class="btn btn-primary">
                Analizar otra opción
            </a>
        </div>
    </div>
</div>
